import java.util.Stack;
import java.util.Queue;
import java.util.LinkedList;

public class FIFOvsLIFO {

    public static void main(String[] args) {

        String word = "madam";

        Stack<Character> stack = new Stack<>();
        Queue<Character> queue = new LinkedList<>();

        // Insert characters into both structures
        for (int i = 0; i < word.length(); i++) {
            char ch = word.charAt(i);
            stack.push(ch);      // LIFO
            queue.add(ch);       // FIFO
        }

        System.out.println("Comparing Queue (FIFO) and Stack (LIFO):");

        boolean isPalindrome = true;

        // Compare dequeue vs pop
        while (!stack.isEmpty()) {
            char fromQueue = queue.remove();  // FIFO
            char fromStack = stack.pop();     // LIFO

            System.out.println("Queue: " + fromQueue + 
                               " | Stack: " + fromStack);

            if (fromQueue != fromStack) {
                isPalindrome = false;
            }
        }

        if (isPalindrome) {
            System.out.println("\nResult: It is a Palindrome.");
        } else {
            System.out.println("\nResult: It is NOT a Palindrome.");
        }
    }
}
